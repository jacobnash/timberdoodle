//
// fbf - a real Haxall connector for FBF's BACnet/Modbus-to-MQTT bridge.
// Subscribes to FBF's already-running bridge output directly (the same
// wire envelope {point, value, ts} mqtt_listener.py/ingest_api.py
// consume), updates point curVal via the real connector framework, and
// lets Haxall's own hisCollectCov historize changes - through "his"
// (TimberdoodleHisExt), into Timberdoodle. This pod does not write to
// Timberdoodle itself; it only makes real BACnet-sourced data available
// as normal Haxall points, exactly like any other real connector would.
//

pragma: Lib <
  doc: "FBF BACnet/Modbus-via-MQTT connector"
  version: "1.0.0"
  depends: {
    { lib: "sys",      versions: BuildVar "ph.depend" }
    { lib: "axon",     versions: BuildVar "hx.depend" }
    { lib: "hx",       versions: BuildVar "hx.depend" }
    { lib: "hx.conn",  versions: "x.x.x" }
  }
  libExt: FbfExt
>

// FBF bridge connector
FbfExt: ConnExt <connFeatures:{pollMode:"manual"}>
