[Unit]
Description=Run timberdoodle-backup.service daily

[Timer]
# EDIT ME: change the schedule by editing this line directly, e.g.
# "Sun *-*-* 04:00:00" for weekly. See `man systemd.time`.
OnCalendar=daily
# Catch up on the next boot if the host was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
