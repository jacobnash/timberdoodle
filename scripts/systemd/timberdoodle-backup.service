[Unit]
Description=Timberdoodle backup (scripts/backup.py)
# Only needs postgres+oxigraph, but requiring docker.service keeps this
# from firing before the daemon is up on a cold boot.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# EDIT ME: path to this checkout.
WorkingDirectory=/opt/timberdoodle
# backup.py shells out to `docker compose exec` - systemd services don't
# inherit a login shell's PATH, so `docker` has to be found explicitly.
Environment=PATH=/usr/bin:/usr/local/bin
ExecStart=/usr/bin/python3 scripts/backup.py
